<% if(typeof errors !== undefined && errors && errors.length > 0) { %>
    <div class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2">
      <ul class="list-disc list-inside">
        <% errors.forEach(error => { %><li><%= error %></li><% }); %>
      </ul>
    </div>
    <% } %>