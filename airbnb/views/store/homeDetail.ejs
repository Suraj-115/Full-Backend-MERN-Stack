<%- include("../partials/head.ejs",{pageTitle:"Home Details"}) %>
  </head>

  <body>
    <%- include("../partials/nav.ejs",{pageTitle:"Home Details", isLoggedIn: typeof isLoggedIn !== 'undefined' ? isLoggedIn : false, user: typeof user !== 'undefined' ? user : null})%>

    <div class="min-h-screen bg-gray-100 flex items-center justify-center p-6">

  <div class="max-w-4xl w-full bg-white rounded-xl shadow-lg overflow-hidden">

    <!-- Image -->
      <img 
        src="<%= home.photoUrl %>" 
        alt="<%= home.houseName %>"
        class="w-full h-72 object-cover"
        onerror="this.style.display='none'"
      />
   
    <div class="p-6 space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">
          <%= home ? home.houseName : "Beautiful Home" %>
        </h1>

        <p class="text-gray-500 mt-1">
          📍 <%= home ? home.location : "Great Location" %>
        </p>

        <% if (home && home.rating) { %>
          <p class="text-yellow-500 font-semibold mt-1">
            ★ <%= home.rating %> Rating
          </p>
        <% } %>
      </div>

      <!-- Description -->
      <div>
        <h2 class="text-lg font-semibold text-gray-700 mb-2">
          About this place
        </h2>
        <p class="text-gray-600 leading-relaxed">
          <% if (home && home.description) { %>
            <%= home.description %>
          <% } else { %>
            This property offers comfort and convenience for your stay.
          <% } %>
        </p>
      </div>

      <!-- Features -->
      <div>
        <h3 class="text-lg font-semibold text-gray-700 mb-2">
          What this place offers
        </h3>

        <div class="grid grid-cols-2 gap-2 text-gray-600 text-sm">
          <span>🏠 Entire home</span>
          <span>✅ Verified listing</span>
          <span>⚡ Fast wifi</span>
          <span>🔑 Self check-in</span>
        </div>
      </div>

      <!-- Booking Section -->
      <div class="border-t pt-4 space-y-3">

        <div class="flex justify-between items-center">
          <div>
            <span class="text-2xl font-bold text-gray-800">
              $<%= home ? home.price : 100 %>
            </span>
            <span class="text-gray-500"> / night</span>
          </div>

          <% if (home && home.rating) { %>
            <span class="text-sm text-gray-500">
              ★ <%= home.rating %>
            </span>
          <% } %>
        </div>

        <% if (home) { %>
          <div class="text-sm text-gray-600 space-y-1">
            <div class="flex justify-between">
              <span>$<%= home.price %> × 3 nights</span>
              <span>$<%= home.price * 3 %></span>
            </div>

            <div class="flex justify-between">
              <span>Service fee</span>
              <span>$<%= Math.round(home.price * 3 * 0.1) %></span>
            </div>

            <div class="flex justify-between font-semibold border-t pt-2">
              <span>Total</span>
              <span>
                $<%= home.price * 3 + Math.round(home.price * 3 * 0.1) %>
              </span>
            </div>
          </div>
        <% } %>

        <!-- Reserve Button -->
        <button class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg transition">
          Reserve Now
        </button>

        <!-- Favorites -->
        <% if (home) { %>
          <div class="pt-2">
            <%- include("../partials/favorites.ejs",{home:home})%>
          </div>
        <% } %>

      </div>

    </div>
  </div>

</div>  
  </body>

  </html>